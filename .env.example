# Optional. Without a token, public repositories work with GitHub's lower anonymous rate limit.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
REQUEST_TIMEOUT_SECONDS=20
MAX_FILE_SIZE=200000
MAX_FILES_TO_SCAN=60
MAX_ISSUES=100
MAX_PRS=100
MAX_RESULTS=20

# stdio for local MCP clients; streamable-http for MCP Inspector / remote connections.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Required when MCP_HOST is not loopback. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=
MCP_RATE_LIMIT_PER_MINUTE=30
# Optional Auth0 OAuth resource-server settings. Configure all three together.
# The Auth0 API identifier should match MCP_OAUTH_RESOURCE_URL when using Auth0's
# Resource Parameter Compatibility Profile.
MCP_OAUTH_ISSUER_URL=
MCP_OAUTH_RESOURCE_URL=
MCP_OAUTH_AUDIENCE=
MCP_OAUTH_REQUIRED_SCOPES=contribscout:read
LOG_LEVEL=INFO
